      "description": "이 데이터는 가상 캠페인, 소재, 집행 및 성과 신호를 설명하기 위한 합성 데이터입니다. 실제 고객, 계정, 광고 플랫폼, 조직 또는 운영 수치를 포함하지 않으며, 상세 구조는 첨부된 Data Dictionary에서 확인할 수 있습니다.",
      "metrics": [
        {
          "ai_context": {
            "synonyms": [
              "Active Campaigns"
            ]
          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_019ffe43-ef34-7170-afe3-93667c550c72\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Distinct count of campaigns whose status is Active.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "COUNT(DISTINCT CASE WHEN marketing_campaign.campaign_status = 'Active' THEN marketing_campaign.campaign_id END)"
              }
            ]
          },
          "name": "Active Campaign Count"
        },
        {
          "ai_context": {
            "synonyms": [
              "Engagement Percentage"
