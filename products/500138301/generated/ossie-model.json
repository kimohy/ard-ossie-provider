      "description": "이 데이터는 가상 캠페인, 소재, 집행 및 성과 신호를 설명하기 위한 합성 데이터입니다. 실제 고객, 계정, 광고 플랫폼, 조직 또는 운영 수치를 포함하지 않으며, 상세 구조는 첨부된 Data Dictionary에서 확인할 수 있습니다.",
      "metrics": [
        {
          "ai_context": {
            "synonyms": [
              "노출 수",
              "Impression Count"
            ]
          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_01a00585-ffdd-7426-8aeb-418b176216c6\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Total synthetic advertising impressions.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "SUM(marketing_delivery.impression_count)"
              }
            ]
          },
          "name": "Impressions"
        },
        {
          "ai_context": {
            "synonyms": [
              "반응당 비용 단위"
            ]
          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_01a00585-ffdd-7513-adc6-0adc1b0d43a4\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Simulated spend units per engagement; returns NULL when engagements are zero.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "SUM(marketing_delivery.spend_units) / NULLIF(SUM(marketing_delivery.engagement_count), 0)"
              }
            ]
          },
          "name": "Cost per Engagement"
        },
        {
          "ai_context": {
            "synonyms": [
              "캠페인 수"
            ]
          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_01a00585-ffdd-7657-888b-dabd7a9ddb2d\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Count of synthetic campaigns.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "COUNT(DISTINCT marketing_campaign.campaign_id)"
              }
            ]
          },
          "name": "Campaign Count"
        },
        {
          "ai_context": {
            "synonyms": [
              "반응률"
            ]
          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_01a00585-ffdd-768a-b340-5471926a5548\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Ratio of engagements to impressions; returns NULL when impressions are zero.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "CAST(SUM(marketing_delivery.engagement_count) AS DECIMAL(38, 12)) / NULLIF(SUM(marketing_delivery.impression_count), 0)"
