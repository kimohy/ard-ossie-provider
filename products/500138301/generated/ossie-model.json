      "description": "이 데이터는 가상 캠페인, 소재, 집행 및 성과 신호를 설명하기 위한 합성 데이터입니다. 실제 고객, 계정, 광고 플랫폼, 조직 또는 운영 수치를 포함하지 않으며, 상세 구조는 첨부된 Data Dictionary에서 확인할 수 있습니다.",
      "metrics": [
        {
          "ai_context": {
            "synonyms": [
              "가상 가치 단위",
              "Synthetic Value"
            ]
          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_019ff7d5-6663-71b4-ab34-bcfda4fb4ada\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Total non-monetary modeled value units.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "SUM(marketing_outcome.modeled_value_units)"
              }
            ]
          },
          "name": "Modeled Value Units"
        },
        {
          "ai_context": {
            "synonyms": [
              "반응당 비용 단위"
            ]
          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_019ff7d5-6663-7596-adfd-64bc31e14d57\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Simulated cost units per engagement; returns NULL when there are no engagements.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "SUM(marketing_delivery.spend_units) / NULLIF(SUM(marketing_delivery.engagement_count), 0)"
              }
            ]
          },
          "name": "Cost per Engagement"
        },
