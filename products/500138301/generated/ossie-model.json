          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_019ff386-ac28-7446-a7c4-874c0ff83a26\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Count of distinct synthetic campaigns.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "COUNT(DISTINCT campaign_id)"
              }
            ]
          },
          "name": "Campaign Count"
        },
        {
          "ai_context": {
            "synonyms": [
              "활성 캠페인 수"
            ]
          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_019ff386-ac28-7518-89db-d2164f5aec56\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Count of distinct campaigns whose status is Active.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "COUNT(DISTINCT CASE WHEN campaign_status = 'Active' THEN campaign_id END)"
              }
            ]
          },
          "name": "Active Campaign Count"
        },
        {
          "ai_context": {
            "synonyms": [
              "관심 신호 수"
