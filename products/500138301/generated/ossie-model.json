      "description": "이 데이터는 가상 캠페인, 소재, 집행 및 성과 신호를 설명하기 위한 합성 데이터입니다. 실제 고객, 계정, 광고 플랫폼, 조직 또는 운영 수치를 포함하지 않으며, 상세 구조는 첨부된 Data Dictionary에서 확인할 수 있습니다.",
      "metrics": [
        {
          "ai_context": {
            "synonyms": [
              "행동 신호 수"
            ]
          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_019ff5ab-3bf3-7033-b22b-02f46fe384bc\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Total synthetic action signals.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "SUM(marketing_outcome.action_signal_count)"
              }
            ]
          },
          "name": "Action Signals"
        },
        {
          "ai_context": {
            "synonyms": [
              "반응당 비용 단위"
            ]
          },
          "custom_extensions": [
            {
              "data": "{\"id\":\"met_019ff5ab-3bf3-703b-bb1b-595441df604a\",\"kind\":\"metric\",\"namespace\":\"ai_ready_data\"}",
              "vendor_name": "COMMON"
            }
          ],
          "description": "Simulation spend units per engagement; returns NULL when total engagements are zero.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "SUM(marketing_delivery.spend_units) / NULLIF(SUM(marketing_delivery.engagement_count), 0)"
              }
            ]
          },
          "name": "Cost per Engagement"
        },
        {
          "ai_context": {
            "synonyms": [
