              "vendor_name": "COMMON"
            }
          ],
          "description": "Engagements divided by impressions, protected against a zero denominator.",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "CAST(SUM(marketing_delivery.engagement_count) AS DECIMAL(38, 12)) / NULLIF(SUM(marketing_delivery.impression_count), 0)"
              }
            ]
          },
          "name": "Engagement Rate"
