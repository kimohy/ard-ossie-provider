{
  "$defs": {
    "LLMMetadata": {
      "additionalProperties": false,
      "properties": {
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "finish_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_:-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "profile": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Profile",
          "type": "string"
        },
        "provider": {
          "enum": [
            "openai_compatible",
            "azure_openai",
            "vertex_gemini",
            "vertex_claude"
          ],
          "title": "Provider",
          "type": "string"
        },
        "repair_count": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Repair Count",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "retry_count": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "provider",
        "model",
        "elapsed_ms"
      ],
      "title": "LLMMetadata",
      "type": "object"
    },
    "QualityFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "QualityFinding",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ],
      "title": "QualityStatus",
      "type": "string"
    }
  },
  "$id": "https://github.com/kimohy/ard-ossie-provider/schemas/reports/quality-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Artifact Hashes",
      "type": "object"
    },
    "completeness": {
      "maximum": 1,
      "minimum": 0,
      "title": "Completeness",
      "type": "number"
    },
    "hard_errors": {
      "items": {
        "$ref": "#/$defs/QualityFinding"
      },
      "title": "Hard Errors",
      "type": "array"
    },
    "llm_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/LLMMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "product_id": {
      "anyOf": [
        {
          "pattern": "^prd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Product Id"
    },
    "product_version": {
      "anyOf": [
        {
          "maximum": 999,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Product Version"
    },
    "quality_artifact_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Quality Artifact Hashes",
      "type": "object"
    },
    "status": {
      "$ref": "#/$defs/QualityStatus"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/QualityFinding"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "product_id",
    "product_version",
    "completeness",
    "hard_errors",
    "warnings",
    "artifact_hashes"
  ],
  "title": "ARD quality report",
  "type": "object"
}
